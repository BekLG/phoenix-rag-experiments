# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real key here.
#
# The YAML config never contains a key VALUE -- each provider role names the
# environment variable to read instead:
#
#   providers:
#     judge:
#       backend: mistral
#       api_key_env: MISTRAL_API_KEY   # <- the NAME, resolved from this file
#
# So adding a provider means adding its variable here and pointing the relevant
# role's `api_key_env` at it. A missing variable is not a crash at import time;
# it surfaces as an error from the first call that actually needs the key.

MISTRAL_API_KEY=your-mistral-api-key-here

# Roles can be split across providers (see configs/default.yaml for the layout).
# Uncomment whichever you actually point a role at:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
